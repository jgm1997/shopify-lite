# PostgreSQL database connection URL
# Format: postgres://username:password@host:port/database?sslmode=disable
# For production, use sslmode=require instead
DATABASE_URL=postgres://shopify:secret@localhost:5432/shopify?sslmode=disable

# JWT signing secret for token generation and validation
# Use a strong random value (32+ characters recommended)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here